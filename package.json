{
  "name": "restorch-desktop",
  "version": "1.0.0",
  "description": "Restorch Offline POS Desktop Server & Client",
  "main": "entry.js",
  "scripts": {
    "start": "electron .",
    "build:protect": "node scripts/protect-build.js",
    "build:exe": "node scripts/protect-build.js && electron-builder --win"
  },
  "dependencies": {
    "bytenode": "^1.5.7",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0"
  },
  "build": {
    "appId": "com.restorch.pos",
    "productName": "Restorch",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "dist"
    },
    "files": [
      "entry.js",
      "main.jsc",
      "license-public-key.pem",
      "package.json",
      "node_modules/**/*",
      "!main.js",
      "!scripts/**/*",
      "!build-staging/**/*"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://restaurant.learnica.net/desktop-updates"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../fanaye-resturant/public/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Restorch"
    },
    "extraResources": [
      {
        "from": "../pgsql",
        "to": "postgres",
        "filter": [
          "bin/**/*",
          "lib/**/*",
          "share/**/*",
          "!share/doc/**",
          "!share/locale/**",
          "!bin/stackbuilder.exe",
          "!bin/pgbench.exe",
          "!bin/ecpg.exe",
          "!bin/pg_upgrade.exe",
          "!bin/pg_basebackup.exe",
          "!bin/pg_receivewal.exe",
          "!bin/pg_recvlogical.exe",
          "!bin/pg_createsubscriber.exe",
          "!bin/pg_combinebackup.exe",
          "!bin/pg_verifybackup.exe",
          "!bin/pg_waldump.exe",
          "!bin/pg_walsummary.exe",
          "!bin/pg_rewind.exe",
          "!bin/pg_test_fsync.exe",
          "!bin/pg_test_timing.exe",
          "!bin/clusterdb.exe",
          "!bin/reindexdb.exe",
          "!bin/vacuumdb.exe",
          "!bin/vacuumlo.exe",
          "!bin/oid2name.exe",
          "!bin/test_cloexec.exe"
        ]
      },
      {
        "from": "build-staging/backend-dist",
        "to": "backend/dist"
      },
      {
        "from": "../fanaye-resturant-backend/prisma",
        "to": "backend/prisma"
      },
      {
        "from": "../fanaye-resturant-backend/node_modules",
        "to": "backend/node_modules",
        "filter": [
          "**/*",
          "!**/*.map",
          "!**/*.d.ts",
          "!**/*.md",
          "!@types/**/*",
          "!typescript/**/*",
          "!@typescript-eslint/**/*",
          "!eslint/**/*",
          "!@eslint/**/*",
          "!jest/**/*",
          "!@jest/**/*",
          "!ts-jest/**/*",
          "!ts-node/**/*",
          "!prettier/**/*",
          "!@swc/**/*",
          "!@nestjs/cli/**/*",
          "!@nestjs/schematics/**/*",
          "!@nestjs/testing/**/*",
          "!supertest/**/*",
          "!hygen/**/*",
          "!husky/**/*",
          "!release-it/**/*",
          "!@release-it/**/*",
          "!@commitlint/**/*",
          "!env-cmd/**/*"
        ]
      },
      {
        "from": "../fanaye-resturant-backend/package.json",
        "to": "backend/package.json"
      },
      {
        "from": "../fanaye-resturant-backend/eng.traineddata",
        "to": "backend/eng.traineddata"
      },
      {
        "from": "../fanaye-resturant/.next/standalone",
        "to": "frontend"
      },
      {
        "from": "../fanaye-resturant/.next/standalone/node_modules",
        "to": "frontend/node_modules",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      },
      {
        "from": "../fanaye-resturant/.next/static",
        "to": "frontend/.next/static"
      },
      {
        "from": "../fanaye-resturant/public",
        "to": "frontend/public"
      },
      {
        "from": "../fanaye-resturant/public/favicon.png",
        "to": "tray-icon.png"
      }
    ]
  }
}
